{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "http://www.cbr.ru/xbrl_csv/20260403/20260430/dic/xbrl-types.def.json",
  "description" : "XBRL-csv Базовая схема с определениями типов данных",
  "$defs" : {
    "ISO_8601_date" : {
      "description" : "ISO8601 date",
      "type" : "string",
      "pattern" : "^(19|20)\\d{2}-((0[1-9])|(1[0-2]))-((0[1-9])|([1-2][0-9])|(3[0-1]))$",
      "format" : "date"
    },
    "ISO_8601_dateTime" : {
      "description" : "ISO8601 dateTime",
      "type" : "string",
      "pattern" : "^(19|20)\\d{2}-((0[1-9])|(1[0-2]))-((0[1-9])|([1-2][0-9])|(3[0-1]))T(([0-1][0-9])|(2[0-3])):([0-5][0-9]):([0-5][0-9])$",
      "format" : "date-time"
    },
    "identifierType" : {
      "description" : "Вариантный тип - идентификатор организации",
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 256
    },
    "nameType" : {
      "description" : "Скалярный тип - имя",
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 256
    },
    "periodDurationType" : {
      "description" : "Скалярный тип определения периода показателя",
      "type" : "object",
      "properties" : {
        "xbrl:periodStart" : {
          "$ref" : "#/$defs/ISO_8601_date"
        },
        "xbrl:periodEnd" : {
          "$ref" : "#/$defs/ISO_8601_date"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "xbrl:periodStart",
        "xbrl:periodEnd"
      ]
    },
    "periodInstatType" : {
      "description" : "Скалярный тип определения даты показателя",
      "type" : "object",
      "properties" : {
        "xbrli:instant" : {
          "$ref" : "#/$defs/ISO_8601_date"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "xbrli:instant"
      ]
    },
    "enum:enumerationItemType" : {
      "description" : "Скалярный тип csv - перечисление",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "string"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "enum:enumerationItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "enum2:enumerationSetItemType" : {
      "description" : "Скалярный тип csv - перечисление второго типа Extensible Enumerations 2.0",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "string"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "enum2:enumerationSetItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "xbrli:stringItemType" : {
      "description" : "Скалярный тип csv - строка",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "string"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:stringItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "xbrli:booleanItemType" : {
      "description" : "Скалярный тип csv - строка",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "boolean"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:booleanItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "xbrli:pureItemType" : {
      "description" : "Скалярный тип csv - десятичное число",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "decimal"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:pureItemType"
        },
        "xbrli:unit" : {
          "type" : "object",
          "properties" : {
            "id" : {
              "type" : "string",
              "const" : "PURE"
            },
            "xbrli:measure" : {
              "type" : "string",
              "const" : "xbrli:pure"
            }
          },
          "additionalProperties" : false,
          "required" : [
            "id",
            "xbrli:measure"
          ]
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType",
        "xbrli:unit"
      ]
    },
    "xbrli:decimalItemType" : {
      "description" : "Скалярный тип csv - десятичное число",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "decimal"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:decimalItemType"
        },
        "xbrli:unit" : {
          "type" : "object",
          "properties" : {
            "id" : {
              "type" : "string",
              "const" : "PURE"
            },
            "xbrli:measure" : {
              "type" : "string",
              "const" : "xbrli:pure"
            }
          },
          "additionalProperties" : false,
          "required" : [
            "id",
            "xbrli:measure"
          ]
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType",
        "xbrli:unit"
      ]
    },
    "xbrli:monetaryItemType" : {
      "description" : "Скалярный тип csv - десятичное число монетарное",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "decimal"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:monetaryItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ],
      "allOf" : [
        {
          "$ref" : "iso4217Type.def.json#/$defs/iso4217Type"
        }
      ]
    },
    "xbrli:monetaryItemOnlyRublesType" : {
      "description" : "Скалярный тип csv - десятичное число монетарное - только рубли",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "decimal"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:monetaryItemType"
        },
        "xbrli:unit" : {
          "type" : "object",
          "properties" : {
            "id" : {
              "type" : "string",
              "const" : "RUB"
            },
            "xbrli:measure" : {
              "type" : "string",
              "const" : "iso4217:RUB"
            }
          },
          "additionalProperties" : false,
          "required" : [
            "id",
            "xbrli:measure"
          ]
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType",
        "xbrli:unit"
      ]
    },
    "xbrli:dateItemType" : {
      "description" : "Скалярный тип csv - дата",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "date"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:dateItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "xbrli:dateTimeItemType" : {
      "description" : "Скалярный тип csv - дата-время",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "date"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:dateTimeItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "xbrli:timeItemType" : {
      "description" : "Скалярный тип csv - время",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "date"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:timeItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "xbrli:integerItemType" : {
      "description" : "Скалярный тип csv - целое число",
      "type" : "object",
      "properties" : {
        "datatype" : {
          "type" : "string",
          "const" : "integer"
        },
        "http://www.cbr.ru/xbrl-csv/model#columnType" : {
          "type" : "string",
          "const" : "xbrli:integerItemType"
        }
      },
      "additionalProperties" : false,
      "required" : [
        "datatype",
        "http://www.cbr.ru/xbrl-csv/model#columnType"
      ]
    },
    "tableURIType" : {
      "description" : "Тип атрибута \"Имя csv файла\"",
      "type" : "object",
      "properties" : {
        "uri" : {
          "type" : "string",
          "pattern" : "^[\\w,\\s-]+\\.csv$"
        },
        "csvRowsCount" : {
          "$comment" : "Количество строк в csv файле, не включая заголовка",
          "type" : "integer",
          "minimum" : 1
        }
      },
      "additionalProperties" : false,
      "required" : [
        "uri",
        "csvRowsCount"
      ]
    }
  }
}